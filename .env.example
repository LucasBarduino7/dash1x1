# === Meta Marketing API (SOMENTE LEITURA) ===
# Token de longa duração da Marketing API. Permissões mínimas: ads_read.
# Gerar em: https://developers.facebook.com/tools/explorer/
# Para estender o token: https://developers.facebook.com/tools/debug/accesstoken/
META_ACCESS_TOKEN=

# ID da conta de anúncios (sem o prefixo "act_")
META_AD_ACCOUNT_ID=

# Versão da Graph API. Atualize quando o Meta promover uma nova LTS.
META_API_VERSION=v23.0

# Filtro de nome de campanha (case-insensitive contains)
META_CAMPAIGN_FILTER=[1X1]

# === Planilha de leads coloridos (qualificação por cor de célula) ===
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Maio

# === Planilha automatizada (origem dos leads — campaign/adset IDs) ===
GOOGLE_SHEET_RAW_ID=
GOOGLE_SHEET_RAW_TAB=MM OFICIAL [MAI/2026]

# === Período analisado ===
PERIOD_SINCE=2026-05-01
PERIOD_UNTIL=2026-05-31

# === Autenticação do dashboard (Basic Auth multi-user) ===
# Formato: "usuario1:senha1,usuario2:senha2,..."
# Exemplo: "marcos:Sup3rS3nh@,lucas:Outr@S3nh@"
# IMPORTANTE: sem espaços entre os pares; sem aspas; sem caracteres de vírgula nas senhas.
BASIC_AUTH_USERS=
